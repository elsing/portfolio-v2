# Ollama (AI terminal)
OLLAMA_URL=http://<host>:<port>
OLLAMA_MODEL=<model-name>
FOLIO_PROMPT_FILE=<path-to-system-prompt-file>

# Uptime Kuma (status widget)
KUMA_URL=https://<your-kuma-instance>
KUMA_SLUG=<status-page-slug>

# SQLite (click heatmap + AI prompt logs)
DB_PATH=/app/data/portfolio.sqlite
IP_HASH_SALT=<random-long-string>

# Admin panel (separate .env.admin.prod / .env.admin.staging for the admin container):
#   ADMIN_PASSWORD=<choose-a-strong-password>
#   SESSION_SECRET=<random-long-string-for-cookie-signing>
#   ADMIN_PORT=9000
#   DB_PATH=/app/data/portfolio.sqlite

# Umami analytics — points at a separately-run, shared Umami instance
# (not managed by this repo; add this site as a website in its dashboard
# and paste the resulting ID here). Website ID is public, not a secret.
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://<your-shared-umami-host>/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<uuid-from-umami-dashboard>
