# Ollama (AI terminal)
OLLAMA_URL=http://<host>:<port>
OLLAMA_MODEL=<model-name>
FOLIO_PROMPT_FILE=<path-to-system-prompt-file>

# Uptime Kuma (status widget)
KUMA_URL=https://<your-kuma-instance>
KUMA_SLUG=<status-page-slug>

# SQLite (folio-ai prompt logs)
DB_PATH=/app/data/portfolio.sqlite
IP_HASH_SALT=<random-long-string>

# Admin panel (separate .env.admin in each environment's base dir):
#   ADMIN_PASSWORD=<choose-a-strong-password>
#   SESSION_SECRET=<random-long-string-for-cookie-signing>
#   ADMIN_PORT=9000
#   DB_PATH=/app/data/portfolio.sqlite

# Umami analytics — points at a separately-run, shared Umami instance
# (not managed by this repo; add this site as a website in its dashboard
# and paste the resulting ID here). Website ID is public, not a secret.
# These only matter for local dev — deployed images get them baked in by the
# build workflow from GitHub repository Variables.
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# Session replay + heatmaps — ON by default when analytics is on (set to
# false to opt out). Also enable Replay on the website in Umami's dashboard.
NEXT_PUBLIC_ENABLE_REPLAY=true
# Instance base URL — script.js / recorder.js are derived from it
NEXT_PUBLIC_UMAMI_URL=https://<your-shared-umami-host>
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<uuid-from-umami-dashboard>
